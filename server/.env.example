DATABASE_URL=postgres://osrs:osrs@localhost:5432/osrs_xp_tracker
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Cron expression for the hiscores sync (default: every 6 hours, on the
# hour). Override with something short like "*/2 * * * *" while testing.
# SYNC_CRON=0 */6 * * *

# Discord pings for profile claims (optional). Create a webhook in the channel's
# settings (Integrations > Webhooks) and paste its URL. Without it, claims work as
# before and the "I'm in game now" button is hidden.
# DISCORD_CLAIMS_WEBHOOK=https://discord.com/api/webhooks/...
# Your Discord user id (Developer Mode on, right click yourself > Copy User ID), so
# the "I'm in game now" ping mentions you.
# DISCORD_OWNER_ID=123456789012345678

# Grand Exchange prices (the Items page): fetched from the OSRS Wiki every few minutes. The User-Agent tells the wiki who is asking
# (site name and address only). Set GE_DISABLED=1 to turn the price updates off, for example on a laptop.
# GE_USER_AGENT=TickGains (https://tickgains.com) - Grand Exchange prices for the Items page
# GE_DISABLED=1

# Hiscores sync tuning (all optional)
# SYNC_CONCURRENCY=3                  players fetched at once (1 = one at a time)
# SYNC_HOT_HOURS=6                    gained XP this recently: checked every hourly run
# SYNC_WARM_MIN_GAP_MINUTES=165       gained XP within SYNC_ACTIVE_DAYS: checked about every 3 hours
# SYNC_ACTIVE_DAYS=3
# SYNC_IDLE_RECHECK_MINUTES=1410      everyone else: about once a day
